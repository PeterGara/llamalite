<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1014">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="llamalite"
            android:textColor="#E8ECF4"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Server: zastavený"
            android:textColor="#8B93A7"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="▶ Start" />
            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="■ Stop" />
            <Button
                android:id="@+id/btnChat"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Chat ↗" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Model"
            android:textColor="#8B93A7" />
        <Spinner
            android:id="@+id/spinnerModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E2330" />

        <TextView
            android:id="@+id/modelInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#5F6878"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/scanDir"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="/sdcard/Download"
                android:textColor="#E8ECF4"
                android:hint="priečinok so .gguf"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btnScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⟳ Sken" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Kontext (-c)"
            android:textColor="#8B93A7" />
        <EditText
            android:id="@+id/ctx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#E8ECF4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Vlákna (-t)"
            android:textColor="#8B93A7" />
        <EditText
            android:id="@+id/threads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#E8ECF4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="load-mode"
            android:textColor="#8B93A7" />
        <Spinner
            android:id="@+id/loadMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E2330" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="flash-attn"
            android:textColor="#8B93A7" />
        <Spinner
            android:id="@+id/flashAttn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E2330" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="KV cache K / V"
                android:textColor="#8B93A7" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Spinner
                android:id="@+id/ctk"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="#1E2330" />
            <Spinner
                android:id="@+id/ctv"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_height="wrap_content"
                android:background="#1E2330" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/repack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="repack (ARM dotprod, rýchlejší prefill)"
            android:textColor="#E8ECF4" />

        <CheckBox
            android:id="@+id/reasoning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="reasoning (thinking)"
            android:textColor="#E8ECF4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="extra_args (voľné)"
            android:textColor="#8B93A7" />
        <EditText
            android:id="@+id/extraArgs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8ECF4"
            android:hint="napr. --swa-full" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="💾 Uložiť nastavenia" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Log"
            android:textColor="#8B93A7" />
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#0B0D11"
            android:padding="8dp"
            android:textColor="#B7C0D0"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>